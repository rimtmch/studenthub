# Supabase Configuration
# Replace these with your project's Supabase URL and anon/public key.
# In Vite, variables exposed to the client must begin with VITE_
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_DRIVE_WEBAPP_URL=https://script.google.com/macros/s/your-google-script-id/exec
